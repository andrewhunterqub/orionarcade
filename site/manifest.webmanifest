{
  "name": "Orion Arcade",
  "short_name": "Orion Arcade",
  "description": "Free, fun games you can play in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
