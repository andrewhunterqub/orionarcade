<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile-checks the runtime scripts (Sim + Game) against Unity reference assemblies. No editor needed.
       Uses the newest UnityEngine.Modules package on NuGet (2021.3); Unity 6-only APIs are listed in Unity6Shims.cs. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0414;CS0649;CS0169;CS0067;CS0618</NoWarn>
    <DefineConstants>UNITY_WEBGL;UNITY_6000_0_OR_NEWER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" />
  </ItemGroup>
</Project>
